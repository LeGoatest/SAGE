{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposal",
  "type": "object",
  "required": ["id", "title", "status"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string"},
    "status": {"type": "string", "enum": ["draft", "approved", "rejected"]},
    "changes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
